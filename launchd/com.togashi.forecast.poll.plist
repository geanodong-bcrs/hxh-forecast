<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.togashi.forecast.poll</string>

  <!-- Hourly 02:00-09:00 Eastern: the window the reviewer is asleep and cannot
       trigger a run by hand. Eight polls. In EDT that is 15:00-22:00 JST, which
       also happens to cover Togashi's historical evening posting peak. Outside
       this window a run is triggered manually.
       Local wall-clock, so it tracks US daylight saving automatically. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__REPO__/scripts/run_update.py</string>
    <string>--poll</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- `claude` lives in ~/.local/bin and vision_pass.py shells out to it;
       launchd jobs do not inherit a login shell's PATH. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__REPO__/data/automation/launchd.poll.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/automation/launchd.poll.err.log</string>

  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
